# Firebase Web SDK Configuration (Get these from Firebase Console -> Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ichibanstays-uk.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ichibanstays-uk
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ichibanstays-uk.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional Admin Email for Portal Access
NEXT_PUBLIC_ADMIN_EMAIL=contact@ichibanstays.com
