rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the site owner may read or change data (self-registered users must not see leads)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'contact@ichibanstays.com';
    }

    match /consultations/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'preferredDate', 'preferredTime']);
      allow read, update, delete: if isAdmin();
    }
    // Public visitors can submit property projections and inquiries
    match /projections/{docId} {
      allow create: if request.resource.data.keys().hasAll(['firstName', 'lastName', 'email', 'phone'])
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    match /inquiries/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message']);
      allow read, update, delete: if isAdmin();
    }

    // Properties are publicly readable, editable only by authenticated admins
    match /properties/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
